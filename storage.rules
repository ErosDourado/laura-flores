rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      let adminsDoc = firestore.get(/databases/(default)/documents/content/admins);
      return isSignedIn()
        && request.auth.token.email != null
        && adminsDoc != null
        && adminsDoc.data.emails.hasAny([request.auth.token.email, request.auth.token.email.lower()]);
    }
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    function smallEnough() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // Imagens de conteúdo (procedimentos, depoimentos, promo) — leitura pública,
    // escrita só admin.
    match /procedures/{file=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && smallEnough();
    }
    match /testimonials/{file=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && smallEnough();
    }
    match /promo/{file=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && smallEnough();
    }

    // Fotos de perfil do cliente — leitura pública (avatar), escrita apenas pelo dono.
    match /profile/{uid}/{file=**} {
      allow read:  if true;
      allow write: if isSignedIn() && request.auth.uid == uid
                   && isImage() && smallEnough();
    }

    // Catch-all: bloquear tudo o que não foi liberado acima.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
