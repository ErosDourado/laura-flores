rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    function smallEnough() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // Imagens de conteúdo (procedimentos, depoimentos, promo) — leitura pública,
    // escrita só para usuários autenticados. O controle de quem é admin é feito
    // no client (admin.html) via Firestore; o firestore.get() cross-service
    // não funciona de forma confiável nas Storage rules deste projeto.
    match /procedures/{file=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImage() && smallEnough();
    }
    match /testimonials/{file=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImage() && smallEnough();
    }
    match /promo/{file=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImage() && smallEnough();
    }

    // Fotos de perfil do cliente — leitura pública (avatar), escrita apenas pelo dono.
    match /profile/{uid}/{file=**} {
      allow read:  if true;
      allow write: if isSignedIn() && request.auth.uid == uid
                   && isImage() && smallEnough();
    }

    // Catch-all: bloquear tudo o que não foi liberado acima.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
